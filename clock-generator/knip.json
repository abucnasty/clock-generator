{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/browser.ts",
    "src/light.ts",
    "src/record-in-factorio.ts",
    "src/verify-recording.ts",
    "src/rule-calls.ts",
    "src/rules-of-the-game.ts",
    "src/data/generated/prototype-types.ts",
    "src/**/*.test.ts",
    "scripts/**/*.js",
    "scripts/prototype-types/generate.mjs",
    "resources/filter-raw.js",
    "resources/dump-item-weights.js",
    "tests/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts",
    "scripts/**/*.js",
    "resources/*.js",
    "tests/**/*.{ts,js}"
  ],
  "ignoreExportsUsedInFile": true
}
