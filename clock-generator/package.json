{
  "name": "clock-generator",
  "version": "0.8.0",
  "description": "Factorio clock generator for crafting machines",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js"
    },
    "./light": {
      "types": "./dist/light.d.ts",
      "import": "./dist/light.js",
      "require": "./dist/light.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "verify": "tsc && node dist/verify-recording.js",
    "record": "tsc && node dist/record-in-factorio.js",
    "test": "vitest run --project unit",
    "test:generation": "vitest run --project generation",
    "test:all": "vitest run",
    "test:game": "vitest run --config vitest.game.config.ts",
    "test:game:watch": "FACTORIO_HARNESS_WATCH=1 vitest run --config vitest.game.config.ts"
  },
  "keywords": [
    "factorio",
    "clock",
    "generator"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/pako": "^2.0.4",
    "typescript": "^5.8.2",
    "vitest": "^4.0.15",
    "vitest-mock-extended": "^3.1.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "fractionability": "^2.3.3",
    "pako": "^2.1.0",
    "zod": "^4.2.1"
  }
}
