# Logs
logs
*.log
npm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Coverage directory of the tests
coverage
*.lcov

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Output of 'npm pack'
*.tgz

# Build output of the generator and the UI
dist

# TypeScript cache
*.tsbuildinfo

# Optional eslint cache
.eslintcache

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# macOS system files
.DS_Store

# other
.vscode
# worktrees Claude Code creates for its agents
.claude/worktrees/

# the link to the Vercel project that `vercel link` writes, with the ids of the account and the project
.vercel

# local environment files; `npm run test:game` reads clock-generator/.env, made from the example next to it
.env*
!.env.example

# copied from clock-generator/resources by `npm run dev` and `npm run build` in the UI
clock-generator-ui/public/data-filtered.json
clock-generator-ui/public/examples/
