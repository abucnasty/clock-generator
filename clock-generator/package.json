{
  "name": "clock-generator",
  "version": "0.23.0",
  "description": "Factorio clock generator for crafting machines",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js"
    },
    "./light": {
      "types": "./dist/light.d.ts",
      "import": "./dist/light.js",
      "require": "./dist/light.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "verify": "tsc && node dist/verify-recording.js",
    "record": "tsc && node dist/record-in-factorio.js",
    "calls": "tsc && node dist/rule-calls.js",
    "test": "vitest run --project unit",
    "test:generation": "tsc && vitest run --project generation",
    "test:all": "tsc && vitest run",
    "test:game": "vitest run --config vitest.game.config.ts",
    "test:game:watch": "FACTORIO_HARNESS_WATCH=1 vitest run --config vitest.game.config.ts tests/game/builds/scaffold-recordings.game.test.ts",
    "knip": "knip",
    "lint": "eslint .",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "probe": "npm run build && node scripts/capture-probe.js",
    "screenshots": "npm run build && node scripts/capture-mechanics-screenshots.js"
  },
  "keywords": [
    "factorio",
    "clock",
    "generator"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.15.29",
    "@types/pako": "^2.0.4",
    "eslint": "^9.39.2",
    "fractionability": "^2.3.3",
    "globals": "^16.5.0",
    "knip": "5.88.1",
    "sharp": "^0.35.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.15",
    "vitest-mock-extended": "^3.1.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "pako": "^2.1.0",
    "zod": "^4.2.1"
  }
}
